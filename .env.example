# Copy this file to .env and keep the API key private.
# Configure the API base URL; the SDK appends /responses.
# OpenRouter example: https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Optional runtime paths and limits.
AMADEUS_DATABASE_PATH=data/amadeus.db
AMADEUS_IDENTITY_PATH=apps/amadeus/identity.md
AMADEUS_ONTOLOGY_PATH=data/ontology.json
AMADEUS_CONTEXT_CHARS=48000

# Optional local Stage server settings.
AMADEUS_STAGE_HOST=127.0.0.1
AMADEUS_STAGE_PORT=3000
AMADEUS_STAGE_STATIC_ROOT=apps/stage/dist
