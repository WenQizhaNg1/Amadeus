{
  "name": "amadeus",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "bun --env-file=.env run apps/amadeus/src/main.ts",
    "dev:stage": "bun run --filter @amadeus/stage dev",
    "build:stage": "bun run --filter @amadeus/stage build",
    "smoke:llm": "bun run --filter @amadeus/core smoke:llm",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^1.0.0-rc.4",
    "typescript": "^5"
  }
}
